using System;
using System.Runtime.CompilerServices;
class Week
{
    private string[] days =
    {
        "Sunday",
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday"
    };

    public string this[int index]
    {
        get {  return days[index]; }
        set {  days[index] = value; }
    }
}
class Program
{
    static void Main()
    {
        Week week = new Week();
        Console.WriteLine(week[0]);
        Console.WriteLine(week[3]);
        Console.WriteLine(week[6]);
    }
}

